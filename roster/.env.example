# Static JavaScript site: only these public values are emitted for the browser.
ROSTER_PUBLIC_SUPABASE_URL=
ROSTER_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave empty until the owner configures Google OAuth in Supabase.
ROSTER_PUBLIC_SUPABASE_GOOGLE_ENABLED=
# Optional: set to 1 only for an explicitly disconnected design preview.
ROSTER_ACCOUNT_PREVIEW=

# Optional Pexels asset refresh only. Never emitted to the browser.
PEXELS_API_KEY=
